{
  "private": true,
  "homepage": "https://github.com/jahudka/insaner",
  "license": "MIT",
  "author": {
    "name": "Eliška Daniela Kaderová",
    "email": "me@subsonic.cz",
    "url": "https://github.com/jahudka"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jahudka/insaner.git"
  },
  "scripts": {
    ":skip:oxlint": "oxlint --ignore-pattern='core/**' --ignore-pattern='plugins/**'",
    ":skip:oxlint:fix": "oxlint --fix --ignore-pattern='core/**' --ignore-pattern='plugins/**'",
    "oxfmt": "oxfmt --check '!core/' '!plugins/' .",
    "oxfmt:fix": "oxfmt --write '!core/' '!plugins/' .",
    "lint": "pnpm run '/^(oxlint|oxfmt)$/'",
    "format": "pnpm run --sequential '/^(oxlint|oxfmt):fix$/'"
  },
  "dependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "engineStrict": true
}
